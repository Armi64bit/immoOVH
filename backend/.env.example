# Django
SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,<your-app>.up.railway.app

# PostgreSQL (Railway sets DATABASE_URL automatically when you add a Postgres plugin)
# DATABASE_URL=postgres://user:pass@host:5432/db

# CORS — comma-separated origins allowed to call the API
CORS_ALLOWED_ORIGINS=https://www.immoconnect.tn,https://immoconnect.tn,http://localhost:5173,http://127.0.0.1:5173

# JWT lifetimes
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Uploaded images live here. On Railway, attach a volume and set this to the
# mount path (e.g. /data/media). Local default: <backend>/media
# MEDIA_ROOT=/data/media
